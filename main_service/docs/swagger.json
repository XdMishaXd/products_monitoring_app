{
    "swagger": "2.0",
    "info": {
        "description": "Сервис мониторинга товаров",
        "title": "Products monitoring service API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/product": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "## Описание\nВозвращает детальную информацию о конкретном товаре по его ID.\n\n### Процесс получения:\n1. Извлечение product_id из query параметра `id`\n2. Валидация ID (должен быть положительным числом)\n3. Проверка авторизации (JWT токен)\n4. Получение товара из базы данных\n5. Проверка статуса парсинга товара\n6. Возврат детальной информации\n\n### Информация о товаре:\n- Базовая информация: ID, URL, название, маркетплейс\n- Текущая цена и валюта\n- История изменений цены (массив объектов с ценой и датой)\n- Статистика: минимальная, максимальная и средняя цена\n- Даты: добавления товара и последнего обновления\n- Статус парсинга (успешно, в процессе, ошибка)\n\n### Статусы парсинга:\n- **409 Conflict**: Товар добавлен, но еще не распарсен (подождите 1-2 минуты)\n- **500 Parsing error**: Ошибка при парсинге (недоступен сайт или изменилась структура)\n- **200 OK**: Товар успешно распарсен, данные актуальны\n\n### Кэширование:\n- Ответ кэшируется на клиенте на 60 секунд\n- Private cache (только для конкретного пользователя)\n- При изменении цены кэш автоматически инвалидируется\n\n### История цен:\nИспользуется для построения графиков изменения цены во времени.\nСодержит все зафиксированные изменения с момента добавления товара.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "products"
                ],
                "summary": "Получить товар по ID",
                "parameters": [
                    {
                        "minimum": 1,
                        "type": "integer",
                        "example": 42,
                        "description": "ID товара",
                        "name": "id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Детальная информация о товаре",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "product": {
                                    "type": "object"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Некорректный ID: отсутствует, не число или отрицательное\"  example({\"status\": \"error\", \"error\": \"Invalid id\"})",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Требуется авторизация\"  example({\"status\": \"error\", \"error\": \"Unauthorized\"})",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Товар не найден\"  example({\"status\": \"error\", \"error\": \"Product not found\"})",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Товар еще не распарсен, подождите\"  example({\"status\": \"error\", \"error\": \"Product not yet received\"})",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Ошибка парсинга или внутренняя ошибка\"  example({\"status\": \"error\", \"error\": \"Parsing error\"})",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "x-order": 4
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "## Описание\nУдаляет товар из списка отслеживаемых для текущего пользователя.\n\n### Процесс удаления:\n1. Извлечение product_id из query параметра `id`\n2. Валидация ID (должен быть положительным числом)\n3. Проверка авторизации (JWT токен)\n4. Извлечение user_id из токена\n5. Проверка что товар принадлежит пользователю\n6. Удаление товара из базы данных\n7. Остановка мониторинга цены\n\n### Что удаляется:\n- Запись товара из таблицы products\n- История изменений цен\n- Настроенные уведомления для этого товара\n- Планировщик мониторинга цены\n\n### Безопасность:\n- Пользователь может удалить только **свои** товары\n- Попытка удалить чужой товар вернет 404 (не раскрываем существование)\n- Требуется валидный JWT токен\n\n### Важно:\n- Удаление **необратимо**\n- История цен также удаляется\n- Для восстановления нужно добавить товар заново",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "products"
                ],
                "summary": "Удалить товар из отслеживания",
                "parameters": [
                    {
                        "minimum": 1,
                        "type": "integer",
                        "example": 42,
                        "description": "ID товара для удаления",
                        "name": "id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Товар успешно удален из отслеживания\"  example({\"status\": \"ok\"})",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Некорректный ID: отсутствует, не число или отрицательное значение\"  example({\"status\": \"error\", \"error\": \"Invalid id\"})",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Требуется авторизация: отсутствует или невалидный JWT токен\"  example({\"status\": \"error\", \"error\": \"Unauthorized\"})",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Товар не найден или не принадлежит пользователю\"  example({\"status\": \"error\", \"error\": \"Product not found\"})",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера\"  example({\"status\": \"error\", \"error\": \"Internal error\"})",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "x-order": 3
            }
        },
        "/product/add": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "## Описание\nДобавляет товар из маркетплейса в список отслеживаемых для мониторинга цен.\n\n### Процесс добавления:\n1. Валидация URL товара и названия\n2. Определение маркетплейса по URL (Etsy, eBay, AliExpress)\n3. Извлечение user_id из JWT токена (Authorization header)\n4. Проверка что товар еще не отслеживается пользователем\n5. Сохранение товара в базу данных\n6. Запуск фонового мониторинга цены\n\n### Поддерживаемые маркетплейсы:\n- **Etsy**: `https://www.etsy.com/listing/...`\n- **eBay**: `https://www.ebay.com/itm/...`\n- **AliExpress**: `https://aliexpress.com/item/...` или `https://aliexpress.ru/item/...`\n\n### URL Requirements:\n- Валидный URL формат (протокол + домен)\n- Ссылка должна вести на страницу товара\n- Маркетплейс должен поддерживаться системой\n\n### Мониторинг цен:\nПосле добавления товара система:\n- Автоматически парсит начальную цену\n- Проверяет цену каждые N часов (настраивается)\n- Отправляет уведомления при изменении цены\n- Строит график истории цен\n\n### Лимиты:\n- Максимум 100 товаров на пользователя (можно настроить)\n- Размер запроса: 1 МБ\n- Timeout: 3 секунды",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "products"
                ],
                "summary": "Добавить товар для отслеживания",
                "parameters": [
                    {
                        "description": "URL и название товара",
                        "name": "product",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "properties": {
                                "title": {
                                    "type": "string"
                                },
                                "url": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Товар добавлен в отслеживание\"  example({\"status\": \"ok\", \"product_id\": 42})",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "product_id": {
                                    "type": "integer"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Требуется авторизация: отсутствует или невалидный JWT токен\"  example({\"status\": \"error\", \"error\": \"Unauthorized\"})",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Ошибка валидации: некорректный URL, отсутствует название или товар уже отслеживается\"  example({\"status\": \"error\", \"error\": \"Product already tracking\"})",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера\"  example({\"status\": \"error\", \"error\": \"Internal error\"})",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "x-order": 1
            }
        },
        "/products": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "## Описание\nВозвращает список всех товаров, которые отслеживает текущий пользователь, с поддержкой пагинации.\n\n### Процесс получения:\n1. Извлечение параметров пагинации (limit, offset) из query\n2. Валидация параметров (limit \u003c= 100, offset \u003e= 0)\n3. Проверка авторизации (JWT токен)\n4. Извлечение user_id из токена\n5. Получение списка товаров из базы данных\n6. Формирование метаданных пагинации\n7. Возврат результата с заголовком Cache-Control\n\n### Параметры пагинации:\n- **limit**: Количество товаров на странице (по умолчанию: 20, максимум: 100)\n- **offset**: Количество товаров для пропуска (по умолчанию: 0)\n\n### Формула пагинации:\n- Страница 1: `offset=0, limit=20`\n- Страница 2: `offset=20, limit=20`\n- Страница 3: `offset=40, limit=20`\n\n### Метаданные ответа:\n- **total**: Общее количество товаров пользователя\n- **total_pages**: Общее количество страниц\n- **has_more**: Есть ли еще товары (для бесконечного скролла)\n\n### Кэширование:\n- Ответ кэшируется на клиенте на 60 секунд (Cache-Control: private, max-age=60)\n- Private cache означает что только браузер пользователя кэширует ответ\n\n### Структура товара:\nКаждый товар содержит:\n- ID, URL, название\n- Маркетплейс (etsy, ebay, aliexpress)\n- Текущая цена и валюта\n- История изменений цены\n- Дата добавления и последнего обновления",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "products"
                ],
                "summary": "Получить список отслеживаемых товаров",
                "parameters": [
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "default": 20,
                        "example": 20,
                        "description": "Количество товаров на странице",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "minimum": 0,
                        "type": "integer",
                        "default": 0,
                        "example": 0,
                        "description": "Количество товаров для пропуска",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список товаров с метаданными пагинации",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "pagination": {
                                    "type": "object",
                                    "properties": {
                                        "has_more": {
                                            "type": "boolean"
                                        },
                                        "limit": {
                                            "type": "integer"
                                        },
                                        "offset": {
                                            "type": "integer"
                                        },
                                        "total": {
                                            "type": "integer"
                                        },
                                        "total_pages": {
                                            "type": "integer"
                                        }
                                    }
                                },
                                "products": {
                                    "type": "array",
                                    "items": {
                                        "type": "object"
                                    }
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Требуется авторизация: отсутствует или невалидный JWT токен\"  example({\"status\": \"error\", \"error\": \"Unauthorized\"})",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера\"  example({\"status\": \"error\", \"error\": \"Internal error\"})",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "x-order": 2
            }
        }
    }
}